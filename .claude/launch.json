{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relevo",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "relevo.app:crear_app",
        "--factory",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "relevo-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "RELEVO_DB=data/demo.sqlite",
        ".venv/bin/uvicorn",
        "relevo.app:crear_app",
        "--factory",
        "--reload",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
